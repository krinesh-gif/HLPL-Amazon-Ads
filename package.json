{
  "name": "aravi-dashboard",
  "version": "0.1.0",
  "description": "In-house Amazon Ads / marketplace dashboard for Aravi Organic \u2014 starting with the Amazon Ads API integration slice.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "demo": "tsx scripts/demo.ts",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json && vite build",
    "build:web": "vite build",
    "start": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p web/tsconfig.json",
    "auth:url": "tsx scripts/get-auth-url.ts",
    "auth:exchange": "tsx scripts/exchange-code.ts",
    "user:add": "tsx scripts/add-user.ts",
    "sync:profiles": "tsx src/cli.ts sync:profiles",
    "sync:campaigns": "tsx src/cli.ts sync:campaigns",
    "sync:reports": "tsx src/cli.ts sync:reports",
    "sync:keywords": "tsx src/cli.ts sync:keywords",
    "sync:targeting": "tsx src/cli.ts sync:targeting",
    "sync:search-terms": "tsx src/cli.ts sync:search-terms",
    "sync:products": "tsx src/cli.ts sync:products",
    "sync:sb": "tsx src/cli.ts sync:sb",
    "sync:sd": "tsx src/cli.ts sync:sd",
    "sync:all": "tsx src/cli.ts sync:all",
    "db:init": "tsx src/cli.ts db:init",
    "db:seed-demo": "tsx scripts/seed-demo.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.2",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "hono": "^4.13.10"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^8.3.1"
  }
}

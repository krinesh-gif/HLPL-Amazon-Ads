# --- Login with Amazon (LWA) app credentials ---
# Created in Amazon Developer Console after your Ads API access is approved.
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=

# Where Amazon redirects after you approve access during the one-time OAuth consent step.
# Must exactly match a "Allowed Return URLs" entry on your LWA security profile.
AMAZON_ADS_REDIRECT_URI=http://localhost:3456/callback

# Filled in automatically by `npm run auth:exchange` after you complete the consent step once.
# This is the long-lived credential the sync jobs use day to day.
AMAZON_ADS_REFRESH_TOKEN=

# Amazon Ads API region this account's marketplace belongs to: NA | EU | FE
# India (Aravi's marketplace) is EU.
AMAZON_ADS_REGION=EU

# Advertising profile ID for the Aravi India account.
# Leave blank until you've run `npm run sync:profiles` once with a valid refresh token —
# it will print the available profile IDs to pick from.
AMAZON_ADS_PROFILE_ID=

# Local SQLite file the sync jobs read/write. Fine for development;
# swap for Postgres once this grows past one person using it.
DB_PATH=./data/aravi-ads.sqlite
